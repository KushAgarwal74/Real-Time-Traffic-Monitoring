                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "traffic_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    event_time AS \"time\",\n    (camera_gps->>'latitude')::double precision AS latitude,\n    (camera_gps->>'longitude')::double precision AS longitude,\n    event_type,\n    track_id,\n    vehicle_type,\n    confidence,\n    license_plate\nFROM traffic_events\nWHERE\n    camera_gps IS NOT NULL\n    AND camera_gps->>'latitude' IS NOT NULL\n    AND camera_gps->>'longitude' IS NOT NULL\n    AND $__timeFilter(event_time)\nORDER BY event_time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
