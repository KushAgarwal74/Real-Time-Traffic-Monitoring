                        "rawQuery": true,
                        "rawSql": "SELECT\n    vehicle_type,\n    COUNT(*) AS count\nFROM traffic_events\nWHERE vehicle_type IS NOT NULL\nGROUP BY vehicle_type\nORDER BY count DESC;",
